# Fixture copy of the dbt-conventions template, set to the duckdb dialect.
[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 120
# ST06 (select-column order) fights readable staging models; delete this line to turn it back on.
exclude_rules = ST06

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = ./ci
target = ci

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit
