# Local and CI databases may carry a throwaway password; nothing else may.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test
SHADOW_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/shadow
COMPOSE_URL=postgres://app:app@db:5432/app
# Staging through Cloud SQL IAM auth: no password in the string.
STAGING_RO_URL=postgres://app_ro@10.0.0.5:5432/app?sslmode=require
# Production: the whole string lives in the secret store; only its reference is committed.
PROD_URL=postgres://app:${PROD_DB_PASSWORD}@db.example.com:5432/app
